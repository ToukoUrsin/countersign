440,"s":"    /// Types and members that come from metadata (or from another compilation) have no location in the compilation being analyzed."},{"t":"add","n":1441,"s":"    /// Their problems are reported by the compilation that defines them, so they are dropped here rather than being reported"},{"t":"add","n":1442,"s":"    /// against a location that does not exist, which analyzers are not permitted to do."},{"t":"add","n":1443,"s":"    /// </remarks>"},{"t":"add","n":1444,"s":"    private void ReportIfLocatedInCompilation(Action<Diagnostic> report, Diagnostic diagnostic)"},{"t":"add","n":1445,"s":"    {"},{"t":"add","n":1446,"s":"        if (diagnostic.Location.IsInSource && this.compilation.ContainsSyntaxTree(diagnostic.Location.SourceTree))"},{"t":"add","n":1447,"s":"        {"},{"t":"add","n":1448,"s":"            report(diagnostic);"},{"t":"add","n":1449,"s":"        }"},{"t":"add","n":1450,"s":"    }"},{"t":"add","n":1451,"s":""},{"t":"ctx","o":1429,"n":1452,"s":"    private static Location? GetLocation(IParameterSymbol parameter) => parameter.DeclaringSyntaxReferences.FirstOrDefault()?.GetSyntax().GetLocation();"},{"t":"ctx","o":1430,"n":1453,"s":""},{"t":"ctx","o":1431,"n":1454,"s":"    private static Location? GetParameterListLocation(IMethodSymbol? method) => ((BaseMethodDeclarationSyntax?)method?.DeclaringSyntaxReferences.FirstOrDefault()?.GetSyntax())?.ParameterList.GetLocation();"}],"unitId":"U2"}]},{"id":"F4","path":"tests/MessagePack.SourceGenerator.Tests/GenericsFormatterTests.cs","status":"modified","additions":189,"deletions":0,"language":"csharp","hunks":[{"id":"F4.H1","header":"@@ -1,7 +1,9 @@","oldStart":1,"newStart":1,"lines":[{"t":"ctx","o":1,"n":1,"s":"﻿// Copyright (c) All contributors. All rights reserved."},{"t":"ctx","o":2,"n":2,"s":"// Licensed under the MIT license. See LICENSE file in the project root for full license information."},{"t":"ctx","o":3,"n":3,"s":""},{"t":"add","n":4,"s":"using Microsoft.CodeAnalysis;"},{"t":"ctx","o":4,"n