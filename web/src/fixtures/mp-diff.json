)"},{"t":"add","n":634,"s":"    {"},{"t":"add","n":635,"s":"        MetadataReference definingAssembly = await CompileToMetadataReferenceAsync(\"DefiningProject\", defineSource, languageVersion);"},{"t":"add","n":636,"s":""},{"t":"add","n":637,"s":"        // Run the analyzers and the generator, failing on any diagnostic (the defect surfaced as AD0001 and CS8785)."},{"t":"add","n":638,"s":"        var test = new VerifyCS.Test(ReferencesSet.MessagePack)"},{"t":"add","n":639,"s":"        {"},{"t":"add","n":640,"s":"            LanguageVersion = languageVersion,"},{"t":"add","n":641,"s":"            TestBehaviors = TestBehaviors.SkipGeneratedSourcesCheck,"},{"t":"add","n":642,"s":"            TestState ="},{"t":"add","n":643,"s":"            {"},{"t":"add","n":644,"s":"                Sources = { usageSource },"},{"t":"add","n":645,"s":"            },"},{"t":"add","n":646,"s":"        };"},{"t":"add","n":647,"s":"        test.TestState.AdditionalReferences.Add(definingAssembly);"},{"t":"add","n":648,"s":"        await test.RunAsync();"},{"t":"add","n":649,"s":""},{"t":"add","n":650,"s":"        // Verify that the resolver was actually generated for the usage assembly, since the defect caused it to be silently omitted."},{"t":"add","n":651,"s":"        ImmutableArray<MetadataReference> frameworkReferences = await ReferenceAssemblies.Net.Net80.ResolveAsync(LanguageNames.CSharp, CancellationToken.None);"},{"t":"add","n":652,"s":"        Compilation usageCompilation = CreateCompilation(\"App\", usageSource, languageVersion, frameworkReferences.Concat(ReferencesHelper.GetReferences(ReferencesSet.MessagePack)).Append(definingAssembly));"},{"t":"add","n":653,"s":"        GeneratorDriverRunResult runResult = CSharpGeneratorDriver.Create(new MessagePack.SourceGenerator.MessagePackGenerator().AsSourceGenerator())"},{"t":"add","n":654,"s":"            .RunGenerators(usageCompilation)"},{"t":"add","n":655,"s":"            .GetRunResult();"},{"t":"add","n":656,"s":"        Assert.Empty(runResult.Diagnostics.Where(d => d.Severity >= DiagnosticSeverity.Warning));"},{"t":"add","n":657,"s":"        var hintNames = runResult.Results.SelectMany(r => r.GeneratedSources).Select(s => s.HintName).ToList();"},{"t":"add","n":658,"s":"        Assert.Contains(expectedResolverHintName, hintNames);"},{"t":"add","n":659,"s":"    }"},{"t":"add","n":660,"s":""},{"t":"add","n":661,"s":"    private static async Task<MetadataReference> CompileToMetadataReferenceAsync(string assemblyName, string source, LanguageVersion languageVersion)"},{"t":"add","n":662,"s":"    {"},{"t":"add","n":663,"s":"        ImmutableArray<MetadataReference> frameworkReferences = await ReferenceAssemblies.Net.Net80.ResolveAsync(LanguageNames.CSharp, CancellationToken.None);"},{"t":"add","n":664,"s":"        Compilation compilation = CreateCompilation(assemblyName, source, languageVersion, frameworkReferences.Concat(ReferencesHelper.GetReferences(ReferencesSet.MessagePack)), OutputKind.DynamicallyLinkedLibrary);"},{"t":"add","n":665,"s":""},{"t":"add","n":666,"s":"        using var stream = new MemoryStream();"},{"t":"add","n":667,"s":"        Microsoft.CodeAnalysis.Emit.EmitResult emitResult = compilation.Emit(stream);"},{"t":"add","n":668,"s":"        if (!emitResult.Success)"},{"t":"add","n":669,"s":"        {"},{"t":"add","n":670,"s":"            throw new InvalidOperationException(\"Failed to compile referenced assembly: \" + string.Join(Environment.NewLine, emitResult.Diagnostics));"},{"t":"add","n":671,"s":"        }"},{"t":"add","n":672,"s":""},{"t":"add","n":673,"s":"        return MetadataReference.CreateFromImage(stream.ToArray());"},{"t":"add","n":674,"s":"    }"},{"t":"add","n":675,"s":""},{"t":"add","n":676,"s":"    private static Compilation CreateCompilation(string assemblyName, string source, LanguageVersion languageVersion, IEnumerable<MetadataReference> references, OutputKind outputKind = OutputKind.DynamicallyLinkedLibrary)"},{"t":"add","n":677,"s":"    {"},{"t":"add","n":678,"s":"        var parseOptions = CSharpParseOptions.Default.WithLanguageVersion(languageVersion);"},{"t":"add","n":679,"s":"        return CSharpCompilation.Create("},{"t":"add","n":680,"s":"            assemblyName,"},{"t":"add","n":681,"s":"            new[] { CSharpSyntaxTree.ParseText(source, parseOptions) },"},{"t":"add","n":682,"s":"            references.ToArray(),"},{"t":"add","n":683,"s":"            new CSharpCompilationOptions(outputKind));"},{"t":"add","n":684,"s":"    }"},{"t":"add","n":685,"s":""},{"t":"ctx","o":497,"n":686,"s":"    /// <summary>"},{"t":"ctx","o":498,"n":687,"s":"    /// Asserts that the generator can handle directly recursive generic constraints."},{"t":"ctx","o":499,"n":688,"s":"    /// </summary>"}],"unitId":"U4"}]}]