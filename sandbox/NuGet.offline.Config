<?xml version="1.0" encoding="utf-8"?>
<!-- User-level NuGet config used in the no-network test step: the only package source is the shared
     global packages folder. Microsoft.CodeAnalysis.Testing resolves its reference assemblies
     (Microsoft.NETCore.App.Ref) through user-level NuGet sources at test time; see prefetch-packages.txt. -->
<configuration>
  <packageSources>
    <clear />
    <add key="sandbox-cache" value="/nuget/packages" />
  </packageSources>
</configuration>
